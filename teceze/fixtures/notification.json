  "message": "<div style=\"font-family: Arial, Helvetica, sans-serif; background-color: #f5f7fa; padding: 30px 15px;\">\r\n\r\n    <div style=\"max-width: 650px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;\">\r\n\r\n        <!-- Header -->\r\n        <div style=\"background-color: #12344d; padding: 20px 25px;\">\r\n            <h2 style=\"margin: 0; color: #ffffff; font-size: 20px; font-weight: 600;\">\r\n                Attendance Request – Approval Required\r\n            </h2>\r\n        </div>\r\n\r\n        <!-- Content -->\r\n        <div style=\"padding: 25px; color: #334155; font-size: 14px; line-height: 1.6;\">\r\n\r\n            <p style=\"margin-top: 0;\">\r\n                Dear <strong style=\"color: #12344d;\">{{ doc.custom_user_name }}</strong>,\r\n            </p>\r\n\r\n            <p>\r\n                A new attendance request has been submitted by\r\n                <strong style=\"color: #12344d;\">{{ doc.employee_name }}</strong>\r\n                and is awaiting your review.\r\n            </p>\r\n\r\n            <!-- Request Status -->\r\n            <div style=\"background-color: #eef6f8; border-left: 4px solid #168aad; padding: 12px 15px; margin: 20px 0;\">\r\n                <strong style=\"color: #12344d; font-size: 15px;\">\r\n                    Attendance Request\r\n                </strong>\r\n                <br>\r\n                <span style=\"color: #475569;\">\r\n                    Please review the request and take the appropriate action.\r\n                </span>\r\n            </div>\r\n\r\n            <!-- Attendance Details -->\r\n            <div style=\"margin-top: 22px; margin-bottom: 22px;\">\r\n\r\n                <div style=\"background-color: #eef6f8; border-left: 4px solid #168aad; padding: 10px 14px; margin-bottom: 12px;\">\r\n                    <strong style=\"color: #12344d; font-size: 15px;\">\r\n                        Attendance Details\r\n                    </strong>\r\n                </div>\r\n\r\n                <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\r\n\r\n                    <tr>\r\n                        <td style=\"padding: 10px 12px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; width: 40%; color: #64748b;\">\r\n                            <strong>Employee</strong>\r\n                        </td>\r\n                        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e2e8f0; color: #334155;\">\r\n                            {{ doc.employee_name }}\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td style=\"padding: 10px 12px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b;\">\r\n                            <strong>Reason</strong>\r\n                        </td>\r\n                        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e2e8f0;\">\r\n                            {{ doc.reason or \"Not provided\" }}\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td style=\"padding: 10px 12px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b;\">\r\n                            <strong>From Date</strong>\r\n                        </td>\r\n                        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e2e8f0;\">\r\n                            {{ frappe.utils.formatdate(doc.from_date) }}\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td style=\"padding: 10px 12px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b;\">\r\n                            <strong>To Date</strong>\r\n                        </td>\r\n                        <td style=\"padding: 10px 12px; border-bottom: 1px solid #e2e8f0;\">\r\n                            {{ frappe.utils.formatdate(doc.to_date) }}\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td style=\"padding: 10px 12px; background-color: #f8fafc; color: #64748b;\">\r\n                            <strong>Half Day</strong>\r\n                        </td>\r\n                        <td style=\"padding: 10px 12px;\">\r\n                            {% if doc.half_day %}\r\n                                Yes\r\n                            {% else %}\r\n                                No\r\n                            {% endif %}\r\n                        </td>\r\n                    </tr>\r\n\r\n                </table>\r\n            </div>\r\n\r\n            <!-- Action Message -->\r\n            <div style=\"background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 14px 16px; margin-bottom: 22px;\">\r\n                Please review the attendance request and take the appropriate action through the\r\n                <strong style=\"color: #12344d;\">TECEZE Portal</strong>.\r\n            </div>\r\n\r\n            <!-- Button -->\r\n            <div style=\"text-align: center; margin: 25px 0;\">\r\n\r\n                <a href=\"{{ frappe.utils.get_url_to_form('Attendance Request', doc.name) }}\"\r\n                   style=\"display: inline-block;\r\n                          background-color: #168aad;\r\n                          color: #ffffff;\r\n                          text-decoration: none;\r\n                          padding: 12px 24px;\r\n                          border-radius: 5px;\r\n                          font-size: 14px;\r\n                          font-weight: 600;\">\r\n                    View Attendance Request\r\n                </a>\r\n\r\n            </div>\r\n\r\n            <p style=\"margin-bottom: 0;\">\r\n                Regards,<br>\r\n                <strong style=\"color: #12344d;\">HR Team</strong><br>\r\n                <span style=\"color: #94a3b8; font-size: 12px;\">\r\n                    TECEZE Portal\r\n                </span>\r\n            </p>\r\n\r\n        </div>\r\n\r\n        <!-- Footer -->\r\n        <div style=\"background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 25px; text-align: center;\">\r\n            <span style=\"font-size: 11px; color: #94a3b8;\">\r\n                This is an automated notification from TECEZE Portal. Please do not reply to this email.\r\n            </span>\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>",
